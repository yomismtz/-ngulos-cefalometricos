<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_home">

    <ScrollView
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="@drawable/header_gradient">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="←"
                    android:textSize="22sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_soft_purple"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Análisis"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnOpen"
                    android:layout_width="86dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="🖼 Imagen"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#15383D"
                    android:background="@drawable/button_soft_mint"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtStudyInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estudio sin nombre · Paciente sin nombre"
                android:textColor="#2C7E86"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="5dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/txtCalibration"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:text="Medidas lineales: sin calibrar"
                    android:textSize="10sp"
                    android:textColor="#2C7E86"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />

                <TextView
                    android:id="@+id/btnCalibrate"
                    android:layout_width="116dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="📏 CALIBRAR"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textColor="#15383D"
                    android:background="@drawable/button_soft_mint"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        <TextView
                android:id="@+id/txtProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Punto seleccionado"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#5B3FA4"
                android:background="@drawable/card_white"
                android:padding="9dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:scrollbars="none"
                android:layout_marginTop="5dp">

                <LinearLayout
                    android:id="@+id/pointChips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/btnPrevious"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="← Anterior"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#5B3FA4"
                    android:background="@drawable/button_soft_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginRight="3dp" />

                <TextView
                    android:id="@+id/btnPointHelp"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="Dónde está"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#15383D"
                    android:background="@drawable/button_soft_mint"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp" />

                <TextView
                    android:id="@+id/btnNext"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="Siguiente →"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#5B3FA4"
                    android:background="@drawable/button_soft_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Instrucción"
                android:textSize="11sp"
                android:textColor="#3D3946"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
            
            


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnUndo"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="DESHACER&#10;PUNTO ANTERIOR"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#5B3FA4"
                    android:background="@drawable/button_soft_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginRight="4dp" />

                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="BORRAR TODOS&#10;LOS PUNTOS"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#5B3FA4"
                    android:background="@drawable/button_soft_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/btnFit"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="CENTRAR"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#15383D"
                    android:background="@drawable/button_soft_mint"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginRight="3dp" />

                <TextView
                    android:id="@+id/btnSaveStudy"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.25"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="💾 DATOS / GUARDAR"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textColor="#15383D"
                    android:background="@drawable/button_soft_mint"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp" />

                <TextView
                    android:id="@+id/btnLock"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1.25"
                    android:gravity="center"
                android:textAlignment="center"
                    android:text="🔓 BLOQUEAR"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textColor="#5B3FA4"
                    android:background="@drawable/button_soft_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginLeft="3dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAssisted"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Detección asistida · información"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#2C7E86"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
            android:textAlignment="center"
                android:text="CALCULAR ANÁLISIS"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_primary_centered"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>

    <Space
        android:layout_width="18dp"
        android:layout_height="match_parent" />

    <com.cefalo.angulos.MeasurementView
        android:id="@+id/measurementView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/panel_dark" />
</LinearLayout>
