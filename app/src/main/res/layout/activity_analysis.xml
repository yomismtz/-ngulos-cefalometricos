<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/header_gradient">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_soft_purple"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Análisis"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnOpen"
            android:layout_width="82dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Imagen"
            android:textStyle="bold"
            android:textColor="#15383D"
            android:background="@drawable/button_soft_mint"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/txtProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Punto 1"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#5B3FA4"
            android:background="@drawable/card_white"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instrucción"
            android:textSize="13sp"
            android:textColor="#3D3946"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <com.cefalo.angulos.MeasurementView
        android:id="@+id/measurementView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/panel_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_margin="12dp"
        android:background="@drawable/card_white"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Deshacer"
                android:textStyle="bold"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Borrar"
                android:textStyle="bold"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnFit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Centrar"
                android:textStyle="bold"
                android:textColor="#15383D"
                android:background="@drawable/button_soft_mint"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="CALCULAR ANÁLISIS"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/card_steiner"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>
