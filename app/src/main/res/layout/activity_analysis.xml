<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/header_gradient">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="←"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_soft_purple"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Análisis"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnOpen"
            android:layout_width="82dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Imagen"
            android:textStyle="bold"
            android:textColor="#15383D"
            android:background="@drawable/button_soft_mint"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/txtStudyMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estudio sin nombre"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#2C7E86"
            android:background="@drawable/card_white"
            android:padding="9dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Punto seleccionado"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#5B3FA4"
            android:background="@drawable/card_white"
            android:padding="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:scrollbars="none"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/pointChips"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="← Anterior"
                android:textStyle="bold"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnPointHelp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.25"
                android:gravity="center"
                android:text="Dónde está"
                android:textStyle="bold"
                android:textColor="#15383D"
                android:background="@drawable/button_soft_mint"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Siguiente →"
                android:textStyle="bold"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instrucción"
            android:textSize="12sp"
            android:textColor="#3D3946"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <com.cefalo.angulos.MeasurementView
        android:id="@+id/measurementView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/panel_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_margin="10dp"
        android:background="@drawable/card_white"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="DESHACER PUNTO ANTERIOR"
                android:textStyle="bold"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="3dp" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="BORRAR TODOS LOS PUNTOS"
                android:textStyle="bold"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp" />

            <TextView
                android:id="@+id/btnFit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Centrar"
                android:textStyle="bold"
                android:textColor="#15383D"
                android:background="@drawable/button_soft_mint"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnStudyData"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="DATOS DEL ESTUDIO / PACIENTE"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#2C7E86"
            android:background="@drawable/button_soft_mint"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="7dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:layout_marginTop="7dp">

            <TextView
                android:id="@+id/btnSaveStudy"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="GUARDAR ESTUDIO"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#15383D"
                android:background="@drawable/button_soft_mint"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnLock"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔓 BLOQUEAR TRAZADO"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#5B3FA4"
                android:background="@drawable/button_soft_purple"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAssisted"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Detección asistida · información"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#2C7E86"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="CALCULAR ANÁLISIS"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/card_steiner"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
