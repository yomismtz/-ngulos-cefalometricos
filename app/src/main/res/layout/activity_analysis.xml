<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/header_gradient">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/back_arrow"
            android:contentDescription="@string/back_accessibility"
            android:textSize="24sp"
            android:textColor="@color/brand_purple"
            android:background="@drawable/button_soft_purple_centered"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/analysis_title_placeholder"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:maxLines="2"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/btnOpen"
            android:layout_width="88dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/open_image"
            android:textStyle="bold"
            android:textColor="@color/mint_text"
            android:background="@drawable/button_soft_mint_centered"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtStudyInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/study_placeholder"
        android:textColor="@color/brand_teal"
        android:textStyle="bold"
        android:textSize="12sp"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp" />

    
    <TextView
        android:id="@+id/txtAutosaveStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:text="@string/autosave_ready"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp" />

<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCalibration"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/linear_uncalibrated"
                android:textSize="11sp"
                android:textColor="@color/brand_teal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp" />

            <TextView
                android:id="@+id/btnCalibrate"
                android:layout_width="118dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/calibrate"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/mint_text"
                android:background="@drawable/button_soft_mint_centered"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/point_selected"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/brand_purple"
            android:gravity="center"
            android:textAlignment="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:background="@drawable/card_point_help"
            android:text="@string/instruction_placeholder"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:text="@string/previous"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/brand_purple"
                android:background="@drawable/button_soft_purple_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:text="@string/next"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="@color/brand_purple"
                android:background="@drawable/button_soft_purple_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp" />
        </LinearLayout>
    </LinearLayout>

    <com.cefalo.angulos.MeasurementView
        android:id="@+id/measurementView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/panel_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/card_white"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/undo_previous"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:textColor="@color/brand_purple"
                android:background="@drawable/button_soft_purple_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/delete_all_points"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:textColor="@color/brand_purple"
                android:background="@drawable/button_soft_purple_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/btnFit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/center_image"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:textColor="@color/mint_text"
                android:background="@drawable/button_soft_mint_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginRight="3dp" />

            <TextView
                android:id="@+id/btnSaveStudy"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.25"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:text="@string/data_save"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:textColor="@color/mint_text"
                android:background="@drawable/button_soft_mint_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp" />

            <TextView
                android:id="@+id/btnLock"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/lock_trace"
                android:textStyle="bold"
                android:textSize="10.5sp"
                android:textColor="@color/brand_purple"
                android:background="@drawable/button_soft_purple_centered"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginLeft="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:textAlignment="center"
            android:text="@string/calculate_analysis"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@drawable/button_primary_centered"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/card_points_bar">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/landmarks_bar"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="@color/brand_purple"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:paddingBottom="4dp" />

        <com.cefalo.angulos.LandmarkFlowLayout
            android:id="@+id/pointChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="2dp"
            android:paddingRight="2dp" />
    </LinearLayout>

</LinearLayout>
