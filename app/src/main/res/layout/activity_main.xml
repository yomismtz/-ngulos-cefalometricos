<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="184dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/cover_hero"
            android:padding="14dp"
            android:elevation="4dp"
            android:layout_marginBottom="18dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:src="@drawable/ic_yomceph_foreground"
                android:background="@drawable/cover_icon_circle"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/cd_yomceph_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="30sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_slogan"
                android:textSize="16sp"
                android:textColor="#EFFFFB"
                android:textStyle="bold"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSteiner"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_primary_centered"
            android:text="@string/analysis_steiner"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/btnVertebral"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_secondary_centered"
            android:text="@string/analysis_vertebral"
            android:textColor="#15383D"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/btnPowell"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_primary_centered"
            android:text="@string/analysis_powell"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/btnTweed"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_secondary_centered"
            android:text="@string/analysis_tweed"
            android:textColor="#15383D"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/btnLevandoski"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_primary_centered"
            android:text="@string/analysis_levandoski"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="2"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="9dp" />

        <TextView
            android:id="@+id/btnAirway"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_secondary_centered"
            android:text="@string/analysis_airway"
            android:textColor="#15383D"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/btnStudies"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:background="@drawable/button_soft_purple_centered"
            android:text="@string/my_analyses"
            android:textColor="#5B3FA4"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:layout_marginBottom="10dp" />

        <ImageView
            android:id="@+id/imgMascot"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:src="@drawable/tooth_ruler_mascot"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_tooth_ruler" />
    </LinearLayout>
</ScrollView>
