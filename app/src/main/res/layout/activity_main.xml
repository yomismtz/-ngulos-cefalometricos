<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_home">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:src="@drawable/yom_logo_transparent"
            android:scaleType="fitCenter"
            android:contentDescription="Logo Yom Dental"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YomCephalometrics"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#5B3FA4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yom Dental · cefalometría angular"
            android:textSize="15sp"
            android:textColor="#2C7E86"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:id="@+id/btnSteiner"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:gravity="center_vertical"
            android:background="@drawable/card_steiner"
            android:text="ANÁLISIS DE STEINER&#10;Solo ángulos cefalométricos"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/btnVertebral"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:gravity="center_vertical"
            android:background="@drawable/card_vertebral"
            android:text="ANÁLISIS VERTEBRAL / CRANEOCERVICAL&#10;Solo mediciones angulares"
            android:textColor="#15383D"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            android:layout_marginBottom="22dp" />

        <TextView
            android:id="@+id/btnStudies"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:background="@drawable/button_soft_purple"
            android:text="MIS ANÁLISIS"
            android:textColor="#5B3FA4"
            android:textStyle="bold"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="3dp"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:elevation="2dp">
            <ImageView
                android:id="@+id/imgMascot"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:src="@drawable/tooth_ruler_mascot"
                android:scaleType="fitCenter"
                android:contentDescription="Mascota Yom Dental" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solo mediciones angulares · sin medidas lineales"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#645B73"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</ScrollView>
