def _safe_json(raw, default):
    try:
        value = json.loads(raw or "")
        return value
    except Exception:
        return default


def _safe_id(text):
    text = re.sub(r"[^a-zA-Z0-9_-]+", "_", (text or "").strip()).strip("_")
    return text[:60] or datetime.now().strftime("study_%Y%m%d_%H%M%S")


def _projection_scalar(p, origin, direction):
    dx, dy = direction
    return (p[0] - origin[0]) * dx + (p[1] - origin[1]) * dy


def _project_point(p, a, b):
    dx, dy = b[0] - a[0], b[1] - a[1]
    den = dx * dx + dy * dy
    if den <= 1e-12:
        return a
    t = ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / den
    return a[0] + t * dx, a[1] + t * dy


def _point_line_distance_px(p, a, b):
    return core.point_line_distance(p, a, b)


class YomCephV120(v116final.YomCephV116Final):
    """YomCeph v0.12: flujo Caso individual / Investigación y protocolo seleccionable."""

    def __init__(self):
        self.workflow_type = "individual"
        self.current_study_id = None
        self.current_study = None
        self.selected_measure_keys = []
        self.steiner_reference = "none"
        self.case_group_values = {}
        self.manual_eligibility = "pending"
        self._legacy_top_widgets = []
        self._left_pane = self._center_pane = self._right_pane = None
        self._left_visible = True
        self._right_visible = True
        self._resize_job = None
        self._startup_home_shown = False
