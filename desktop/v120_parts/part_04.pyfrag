        self.institution_var.set(study.get("institution") or "")
        self.analysis_mode = "Ambos"
        self._apply_selected_measurements()
        self._update_compact_context()
        self.status.config(text=f"Investigación activa: {study['name']}. Capture los datos del caso y abra la radiografía.")
        self.open_case_data(first_time=True)

    # ------------------------------------------------------------------
    # Constructor de protocolo / selector de análisis
    # ------------------------------------------------------------------
    def open_protocol_editor(self, new_study=False):
        existing = None if new_study else self.current_study
        if existing and existing.get("protocol_locked"):
            self._show_locked_protocol(existing)
            return

        win = tk.Toplevel(self)
        win.title("YomCeph · Protocolo de investigación")
        win.transient(self); win.grab_set()
        sw, sh = self.winfo_screenwidth(), self.winfo_screenheight()
        w, h = min(980, int(sw*.92)), min(820, int(sh*.90))
        win.geometry(f"{w}x{h}+{max(0,(sw-w)//2)}+{max(0,(sh-h)//2)}")

        outer = ttk.Frame(win); outer.pack(fill=tk.BOTH, expand=True)
        canvas = tk.Canvas(outer, bg=ui.C["paper"], highlightthickness=0)
        scroll = ttk.Scrollbar(outer, orient="vertical", command=canvas.yview)
        content = ttk.Frame(canvas, padding=18)
        content_id = canvas.create_window((0,0), window=content, anchor="nw")
        canvas.configure(yscrollcommand=scroll.set)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True); scroll.pack(side=tk.RIGHT, fill=tk.Y)
        content.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(content_id, width=e.width))

        ttk.Label(content, text="Diseño de la investigación", style="Section.TLabel", font=("Segoe UI Semibold", 17)).pack(anchor="w")
        ttk.Label(content, text="Este protocolo se reutiliza en todos los casos y se bloquea después del primer caso incluido.", style="Muted.TLabel").pack(anchor="w", pady=(2,12))

        basics = ttk.LabelFrame(content, text="1 · Muestra y criterios", padding=12); basics.pack(fill=tk.X, pady=5)
        name_var = tk.StringVar(value=(existing or {}).get("name", ""))
        target_var = tk.StringVar(value=str((existing or {}).get("target_n", 103)))
        inc_var = tk.BooleanVar(value=bool((existing or {}).get("allow_target_increase", 1)))
        amin_var = tk.StringVar(value="" if (existing or {}).get("age_min") is None else str(existing["age_min"]))
        amax_var = tk.StringVar(value="" if (existing or {}).get("age_max") is None else str(existing["age_max"]))
        country_var = tk.StringVar(value=(existing or {}).get("country", "México"))
        institution_var = tk.StringVar(value=(existing or {}).get("institution", ""))
        steiner_ref_var = tk.StringVar(value=(existing or {}).get("steiner_reference", "none"))

        grid = ttk.Frame(basics); grid.pack(fill=tk.X)
        for c in (1,3): grid.columnconfigure(c, weight=1)
        ttk.Label(grid,text="Nombre de la investigación:").grid(row=0,column=0,sticky="w",padx=4,pady=4)
        ttk.Entry(grid,textvariable=name_var).grid(row=0,column=1,columnspan=3,sticky="ew",padx=4,pady=4)
        ttk.Label(grid,text="Muestra planeada:").grid(row=1,column=0,sticky="w",padx=4,pady=4)
        ttk.Entry(grid,textvariable=target_var,width=8).grid(row=1,column=1,sticky="w",padx=4,pady=4)
        ttk.Checkbutton(grid,text="Permitir aumentar la muestra después",variable=inc_var).grid(row=1,column=2,columnspan=2,sticky="w",padx=4,pady=4)
        ttk.Label(grid,text="Edad mínima (años cumplidos):").grid(row=2,column=0,sticky="w",padx=4,pady=4)
        ttk.Entry(grid,textvariable=amin_var,width=8).grid(row=2,column=1,sticky="w",padx=4,pady=4)
        ttk.Label(grid,text="Edad máxima:").grid(row=2,column=2,sticky="w",padx=4,pady=4)
        ttk.Entry(grid,textvariable=amax_var,width=8).grid(row=2,column=3,sticky="w",padx=4,pady=4)
        ttk.Label(grid,text="País:").grid(row=3,column=0,sticky="w",padx=4,pady=4)
        ttk.Entry(grid,textvariable=country_var).grid(row=3,column=1,sticky="ew",padx=4,pady=4)
        ttk.Label(grid,text="Institución:").grid(row=3,column=2,sticky="w",padx=4,pady=4)
        ttk.Entry(grid,textvariable=institution_var).grid(row=3,column=3,sticky="ew",padx=4,pady=4)

        ttk.Label(basics,text="Criterios de inclusión:").pack(anchor="w", pady=(8,2))
        inclusion = tk.Text(basics,height=3,wrap=tk.WORD); inclusion.pack(fill=tk.X)
        inclusion.insert("1.0", (existing or {}).get("inclusion_criteria", ""))
        ttk.Label(basics,text="Criterios de exclusión:").pack(anchor="w", pady=(8,2))
        exclusion = tk.Text(basics,height=3,wrap=tk.WORD); exclusion.pack(fill=tk.X)
        exclusion.insert("1.0", (existing or {}).get("exclusion_criteria", ""))

        groups = ttk.LabelFrame(content, text="2 · Procedencia, grupo o momento", padding=12); groups.pack(fill=tk.X, pady=5)
        ttk.Label(groups,text="Puede crear una o varias variables. Formato: Nombre=opción1|opción2|opción3",style="Muted.TLabel").pack(anchor="w")
        ttk.Label(groups,text="Ejemplos: Clínica=Tepepan|Tláhuac · Grupo=Caso|Control · Momento=Pre|Post").pack(anchor="w",pady=(2,5))
        group_text = tk.Text(groups,height=5,wrap=tk.WORD); group_text.pack(fill=tk.X)
        if existing:
            lines=[]
            for field in existing.get("group_fields",[]):
                lines.append(field.get("name", "Grupo") + "=" + "|".join(field.get("options",[])))
            group_text.insert("1.0", "\n".join(lines))

        analyses_box = ttk.LabelFrame(content, text="3 · Datos a analizar: análisis y resultados", padding=12); analyses_box.pack(fill=tk.X,pady=5)
        ttk.Label(analyses_box,text="Puede combinar análisis. Sólo las mediciones con fórmula verificada aparecen activables; las demás se muestran como 'en validación'.",style="Muted.TLabel",wraplength=820).pack(anchor="w",pady=(0,8))

        analysis_vars = {}
        measure_vars = {}
        selected_existing = set((existing or {}).get("measurements", []))
        selected_analyses_existing = set((existing or {}).get("analyses", []))
        for aid, spec in ANALYSES.items():
            frame = ttk.LabelFrame(analyses_box, text=spec["name"], padding=8); frame.pack(fill=tk.X,pady=4)
            status = spec.get("status")
            active_measure_list = analysis_measurements(aid, active_only=True)
            can_select = bool(active_measure_list)
            av = tk.BooleanVar(value=(aid in selected_analyses_existing or any(k in selected_existing for k in active_measure_list)))
            analysis_vars[aid]=av
            cb = ttk.Checkbutton(frame,text="Incluir este análisis",variable=av)
            cb.pack(anchor="w")
            if not can_select:
                cb.state(["disabled"])
            status_text = {
                STATUS_ACTIVE:"Disponible y calculable",
                STATUS_VALIDATION:"En validación científica / geométrica",
                STATUS_REFERENCE_ONLY:"Referencia metodológica; no hay un único módulo canónico confirmado",
                STATUS_OTHER_PROJECTION:"Requiere otra proyección radiográfica",
            }.get(status,status)
            ttk.Label(frame,text=f"{status_text}. {spec.get('summary','')}",style="Muted.TLabel",wraplength=820,justify=tk.LEFT).pack(anchor="w",padx=(22,0),pady=(2,4))
            if spec.get("missing_landmarks"):
                ttk.Label(frame,text="Landmarks/constructores pendientes: " + ", ".join(spec["missing_landmarks"]),style="Muted.TLabel",wraplength=820).pack(anchor="w",padx=(22,0))
            for key in active_measure_list:
                mv=tk.BooleanVar(value=(key in selected_existing))
                measure_vars[key]=mv
                ttk.Checkbutton(frame,text=MEASUREMENTS[key]["label"],variable=mv).pack(anchor="w",padx=(35,0))

        refbox = ttk.LabelFrame(content,text="4 · Referencia para interpretar Steiner",padding=12); refbox.pack(fill=tk.X,pady=5)
        ttk.Label(refbox,text="Las mediciones siempre se guardan como valores crudos. La clasificación depende de la referencia elegida.",style="Muted.TLabel").pack(anchor="w")
        ttk.Radiobutton(refbox,text="Sin clasificación automática (recomendado si el protocolo no define normas)",value="none",variable=steiner_ref_var).pack(anchor="w")
        ttk.Radiobutton(refbox,text="Referencia clásica publicada de Steiner",value="classic",variable=steiner_ref_var).pack(anchor="w")
        ttk.Radiobutton(refbox,text="Protocolo UAM 2026 (valores de tu investigación)",value="uam2026",variable=steiner_ref_var).pack(anchor="w")

        buttons=ttk.Frame(content); buttons.pack(fill=tk.X,pady=(12,20))
        def save_protocol():
            name=name_var.get().strip()
